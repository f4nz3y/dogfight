{
  "name": "dogfight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test:shared": "node --test shared/test/*.test.js",
    "test": "node --test shared/test/*.test.js server/test/*.test.js",
    "bench:codec": "node shared/bench/codec-bench.js"
  },
  "engines": {
    "node": ">=22"
  }
}
