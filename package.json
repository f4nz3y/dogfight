{
  "name": "dogfight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test:shared": "node --experimental-strip-types --test shared/test/*.test.ts",
    "test": "vitest run",
    "bench:codec": "node --experimental-strip-types shared/bench/codec-bench.ts",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace server && npm run typecheck --workspace client",
    "test:offline": "node --experimental-strip-types --test shared/test/*.test.ts server/test/*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "load": "node --experimental-strip-types server/bench/load.ts",
    "bench:worker": "node --experimental-strip-types client/bench/worker-bench.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "fast-check": "^4.2.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pino": "^10.4.0"
  }
}
